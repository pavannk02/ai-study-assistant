# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  Copy this file to .env and fill in your own values.
#                  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini (Google AI Studio) ─────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
# Free tier: check current limits at https://ai.google.dev/pricing
# Recommended free model as of 2025: gemini-2.0-flash-lite
# ⚠️  Models change often – verify the current free model at the link above.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# ── Groq ──────────────────────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com/keys
# Free tier limits: https://console.groq.com/settings/limits
# Recommended free model as of 2025: llama-3.1-8b-instant
# ⚠️  Models change often – verify at https://console.groq.com/docs/models
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Cerebras ──────────────────────────────────────────────────────────────────
# Get your free key at: https://cloud.cerebras.ai
# Free trial credits available on sign-up (no credit card needed).
# ⚠️  Check current model list at https://inference-docs.cerebras.ai/models
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-8b

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get your free key at: https://openrouter.ai/keys
# Free models use the ":free" suffix.  The lineup changes frequently.
# ⚠️  Always check https://openrouter.ai/models?q=free for the current list.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# ── Ollama (fully local, no API key needed) ────────────────────────────────────
# Install Ollama from: https://ollama.com/download
# Pull a model: ollama pull llama3.2:3b   (fits in 4 GB VRAM)
# Larger models (e.g. llama3.1:8b) also work on 16 GB RAM but are slower.
# Leave OLLAMA_API_KEY blank – Ollama does not use one.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.2:3b

# ── Provider order & retrieval settings ───────────────────────────────────────
# Comma-separated list of providers to try in order.
# Valid values: gemini, groq, cerebras, openrouter, ollama
# The app always falls back to retrieval-only mode if every provider fails.
LLM_PROVIDER_ORDER=gemini,groq,cerebras,openrouter,ollama

# Number of top chunks to retrieve per query (also adjustable in the sidebar).
TOP_K=4

# ── Chunking parameters ───────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
