# ─── Secrets — NEVER commit these ──────────────────────────────────────────────
.env

# ─── Vector index & chunk data (regenerated from PDFs) ─────────────────────────
data/*
!data/.gitkeep

# ─── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ─── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Test & coverage artifacts ──────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ─── OS-specific ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE-specific ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp